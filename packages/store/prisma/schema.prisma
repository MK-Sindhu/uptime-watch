// use prisma-8

model Website {
  id                        String          @id          @default(uuid())
  url                       String        
  timeAdded                 DateTime
  ticks                     WebsiteTick[]
}

model Region {
  id                        String           @id         @default(uuid())
  name                      String
  ticks                     WebsiteTick[]
}

model WebsiteTick {
  id                        String           @id         @default(uuid())
  response_time_ms          Int
  status                    WebsiteStatus
  region                    Region           @relation(fields: [region_id], references:  [id])
  website                   Website          @relation(fields: [website_id], references:  [id])
  region_id                 String
  website_id                String
}

enum WebsiteStatus {
  Up
  Down
  Unknown
}