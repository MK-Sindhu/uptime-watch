# Copy this file to `.env` in this folder and fill in real values.
# Bun loads .env from the folder you run `bun index.ts` in.
# In Kubernetes, set these on the worker Deployment instead.

# Id of a row in the Postgres `region` table. Each region is its own consumer group.
# List the ids with:  psql "$DATABASE_URL" -c 'SELECT id, name FROM region;'
REGION_ID="replace-with-a-region-id"

# Unique name for this worker inside its region.
# Leave it unset in Kubernetes: the pod's HOSTNAME is used.
WORKER_ID="local-1"

# Redis that holds the queue of websites to check.
REDIS_URL="redis://localhost:6379"

# ClickHouse that stores the check results.
# Local values match the Docker container in the README. In Kubernetes, put the password in a Secret.
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="uptime"
CLICKHOUSE_PASSWORD="uptime"
CLICKHOUSE_DB="uptime"
