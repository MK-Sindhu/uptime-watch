# Copy this file to `.env` in this folder and fill in real values.
# Bun loads .env from the folder you run `bun index.ts` in.
# In Kubernetes, set these on the pusher Deployment instead (replicas: 1).

# Redis that holds the queue of websites to check.
REDIS_URL="redis://localhost:6379"

# How often every website is checked, in seconds. Set the same value on the API.
CHECK_INTERVAL_SECONDS=30

# DATABASE_URL (Postgres) is read from packages/store/.env, not from here.
# A DATABASE_URL already set in the environment (e.g. in Kubernetes) takes precedence.
