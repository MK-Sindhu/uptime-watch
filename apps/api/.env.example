# Copy this file to `.env` in this folder and fill in real values.
# Bun loads .env from the folder you run `bun index.ts` in.
# In Kubernetes, set these on the API Deployment instead.

# Secret used to sign login tokens. Generate one with:  openssl rand -hex 32
# Changing it signs every user out. In Kubernetes, put it in a Secret.
JWT_SECRET="replace-with-a-long-random-string"

# How long a sign-in lasts: "7d", "12h", or a number of seconds.
JWT_EXPIRES_IN="7d"

# Port the API listens on.
PORT=3000

# ClickHouse that stores the check results.
# Local values match the Docker container in the README. In Kubernetes, put the password in a Secret.
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="uptime"
CLICKHOUSE_PASSWORD="uptime"
CLICKHOUSE_DB="uptime"

# Redis that stores the rate-limit counters (shared by every API pod).
REDIS_URL="redis://localhost:6379"

# How often the pusher checks every website, in seconds. Must match the pusher;
# the API uses it to split outages into separate incidents.
CHECK_INTERVAL_SECONDS=30

# Rate limits. Defaults shown; raise the auth limit if repeated test runs hit 429.
RATE_LIMIT_PER_MINUTE=120            # every route except /health, per client IP
RATE_LIMIT_AUTH_PER_15_MIN=20        # sign-up + sign-in, per client IP
RATE_LIMIT_WEBSITES_PER_MINUTE=10    # adding websites, per user
MAX_WEBSITES_PER_USER=20
RATE_LIMIT_AGGREGATES_PER_MINUTE=120         # charts on the site page, per user
RATE_LIMIT_WEBSITE_WRITES_PER_MINUTE=30      # rename/pause/delete, per user
RATE_LIMIT_PUBLIC_STATUS_PER_MINUTE=30       # public status pages, per client IP

# Which proxies may set X-Forwarded-For (Express "trust proxy").
# The default trusts loopback and private networks (Next.js, the Kubernetes ingress).
# TRUST_PROXY="loopback, linklocal, uniquelocal"

# DATABASE_URL (Postgres) is read from packages/store/.env, not from here.
# A DATABASE_URL already set in the environment (e.g. in Kubernetes) takes precedence.
