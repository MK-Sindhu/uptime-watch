# Copy this file to `.env` in this folder and fill in real values.

# Where the Next.js server forwards /api/* requests: the Express API in apps/api.
# For a production build (`next build`), this must be set when building,
# because Next.js bakes rewrites into the build. In Kubernetes that means the
# image build, e.g. API_URL=http://api:3000 for a Service named `api`.
API_URL="http://localhost:3000"
